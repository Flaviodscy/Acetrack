rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "gorodscyflavio@gmail.com";
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isParticipant(data) {
      return request.auth != null
        && data.userIds is list
        && request.auth.uid in data.userIds;
    }

    function isSocialSender(data) {
      return request.auth != null
        && data.fromUserId == request.auth.uid;
    }

    function isSocialParticipant(data) {
      return request.auth != null
        && (data.fromUserId == request.auth.uid || data.toUserId == request.auth.uid);
    }

    match /users/{userId}/matches/{matchId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId);
    }

    match /users/{userId}/profile/{profileId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    match /{path=**}/profile/{profileId} {
      allow read: if isAdmin();
    }

    match /publicLocations/{userId} {
      allow read: if request.auth != null;
      allow write: if isOwner(userId);
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /socialRequests/{requestId} {
      allow read, update, delete: if isSocialParticipant(resource.data) || isAdmin();
      allow create: if isSocialSender(request.resource.data);
    }

    match /friendships/{friendshipId} {
      allow read, update, delete: if isParticipant(resource.data) || isAdmin();
      allow create: if isParticipant(request.resource.data);
    }

    match /socialActions/{actionId} {
      allow read, update, delete: if isSocialParticipant(resource.data) || isAdmin();
      allow create: if isSocialSender(request.resource.data);
    }

    match /socialMessages/{messageId} {
      allow read, update, delete: if isParticipant(resource.data) || isAdmin();
      allow create: if isSocialSender(request.resource.data)
        && isParticipant(request.resource.data);
    }

    match /matchRemotes/{sessionId} {
      allow read, update, delete: if isOwner(resource.data.ownerUserId) || isAdmin();
      allow create: if isOwner(request.resource.data.ownerUserId);

      match /commands/{commandId} {
        function remoteSession() {
          return get(/databases/$(database)/documents/matchRemotes/$(sessionId)).data;
        }

        allow create: if request.resource.data.sessionId == sessionId
          && request.resource.data.token == remoteSession().token
          && request.resource.data.type in ["aceA", "aceB", "end", "pointA", "pointB", "undo"];
        allow read, update, delete: if isAdmin()
          || (request.auth != null && remoteSession().ownerUserId == request.auth.uid);
      }
    }
  }
}

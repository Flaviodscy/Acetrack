rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // === ADMIN FUNCTION ===
    function isAdmin() {
      return request.auth != null
        && request.auth.email == "gorodscyflavio@gmail.com";
    }

    // === AUTH CHECK ===
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // === USER PROFILES ===
    // Users can read all profiles (for browsing rankings, searching players)
    match /users/{userId}/profile/main {
      allow read: if isAuthenticated();

      // Users can only write their OWN profile
      // Allows updating: avatarUrl, rating, level, name, shortName, location, etc.
      allow write: if isOwner(userId) && (
        // Allow these specific fields to be written
        resource.data.avatarUrl is string
         || resource.data.rating is string
         || resource.data.level is number
         || resource.data.name is string
         || resource.data.shortName is string
         || resource.data.location is string
      );

      // Admin can do anything
      allow write: if isAdmin();
    }

    // === TOURNAMENTS ===
    match /tournaments/{tourneyId} {
      // Public can read tournaments and participant lists
      allow read: if isAuthenticated() || true;  // Everyone can read

      // Only admin or tournament organizer can create/update
      allow create, update: if isAdmin() ||
        (isAuthenticated() && resource.data.organizerUserId == request.auth.uid);

      allow delete: if isAdmin();
    }

    // === TOURNAMENT PARTICIPANTS ===
    match /tournamentParticipants/{tourneyId} {
      // Anyone can read participants list
      allow read: if isAuthenticated() || true;

      // Authenticated users can create entries (join tournaments)
      allow create: if isAuthenticated();

      // Admin only can delete/manage
      allow update, delete: if isAdmin();
    }

    // === PLAYER RANKINGS ===
    match /playerRankings/{rankingId} {
      // Public leaderboard - read-only for everyone authenticated
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}